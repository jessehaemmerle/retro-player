{
  "name": "retro-player",
  "private": true,
  "version": "1.0.0",
  "description": "Fotorealistischer Retro-Player für Spotify (Plattenspieler, Boombox, Receiver, Walkman, Discman) als installierbare Web-App",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/michroma": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "dseg": "^0.46.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
